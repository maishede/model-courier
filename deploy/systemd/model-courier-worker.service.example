[Unit]
Description=ModelCourier outbound GPU Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/model-courier
EnvironmentFile=/etc/model-courier/worker.env
ExecStart=/opt/model-courier/.venv/bin/python -m model_courier.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
